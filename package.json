{
  "name": "@fazelstudio/username-intelligence",
  "version": "1.1.2",
  "description": "Advanced username analysis library with security scoring, Unicode script detection, and spoofing prevention",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.js --format esm,cjs --dts --clean",
    "test": "node test-optimization.js",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "username",
    "analysis",
    "validation",
    "security",
    "spoofing",
    "homoglyph",
    "unicode",
    "entropy",
    "bot-detection",
    "profanity-filter"
  ],
  "author": {
    "name": "Fazel",
    "email": "zulfazlilsm@gmail.com",
    "url": "https://github.com/fazelllyyy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fazelllyyy/username-intelligence.git"
  },
  "bugs": {
    "url": "https://github.com/fazelllyyy/username-intelligence/issues"
  },
  "homepage": "https://github.com/fazelllyyy/username-intelligence#readme",
  "devDependencies": {
    "prettier": "^3.2.0",
    "rimraf": "^6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
